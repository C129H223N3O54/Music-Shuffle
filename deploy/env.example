# Music Shuffle — Laufzeit-Konfiguration (wird nach data/.env kopiert, nie ins Git)

# Spotify-User-IDs, die den Sync-Server nutzen dürfen (kommagetrennt).
# Leer = jeder, der die Adresse kennt, kann Daten lesen und ändern!
ALLOWED_USERS=

# Adresse(n) der App für CORS (Protokoll + Host + Port, ohne Pfad), kommagetrennt
ALLOWED_ORIGINS=
